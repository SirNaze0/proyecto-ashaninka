# Configuración de PRODUCCIÓN para docker-compose.yml (Fase 6). Copie a .env y complete lo marcado.
#   cp .env.production.example .env
# Nunca versione el .env.
# Sin roles (QuitarAdmin): no hay token administrativo; toda la API es pública (docs/limitations.md).

# --- obligatorio ----------------------------------------------------------------------------------
# Dominio público (HTTPS automático con Let's Encrypt) o `localhost` para probar con certificado propio.
NA_DOMAIN=localhost

# --- servicio -------------------------------------------------------------------------------------
NA_TTS_ENGINE=mms_vits
NA_MMS_ADAPTER=H1
NA_MMS_TOKENIZATION=manual
NA_ALLOW_CANDIDATES=false
# Valores medidos en la Fase 2 para un servidor de 2 vCPU y 2-3 GB (docs/sizing.md): modo por lotes
NA_TTS_WORKERS=1
NA_TORCH_THREADS=2
NA_TTS_PRELOAD=true
NA_MAX_CONCURRENT_SYNTH=4
NA_MAX_NEWS_CHARS=20000
NA_OPUS_KBPS=24
NA_ESPEAK_VOICE=es
# Memoria máxima del contenedor de la aplicación (el pico medido de mms_vits es de ~1,1 GB)
NA_MEM_LIMIT=3g
# Peticiones por minuto y por IP; varios celulares tras un mismo Wi-Fi comparten IP
NA_RATE_LIMIT_PER_MIN=1200

# --- experimento (Fase 5) -------------------------------------------------------------------------
# false = solo noticias revisadas por un hablante (P4). true admite pseudo-noticias y marca todo
# como piloto: NUNCA activarlo con participantes reales.
NA_EXPERIMENT_PILOTO=false
NA_CONSENT_VERSION=PENDIENTE-COMITE-ETICA-v0

# --- traductor BiTAM (es -> cni) ------------------------------------------------------------------
# El servicio de traducción NO forma parte de docker compose (necesita GPU y pesos no
# redistribuibles; ver traductor/README.md). Vacío = la Redacción no ofrece traducción automática.
NA_TRANSLATOR_ENGINE=http
NA_TRANSLATOR_URL=
NA_TRANSLATOR_TIMEOUT=120

# ---------------------------------------------------------------- Noticias de TV Perú (NoticiasTVPeru)
# Lee el RSS de TV Perú cada X minutos (el intervalo se elige en el tablón de la PWA), traduce un resumen
# con BiTAM (NA_TRANSLATOR_URL) y publica las noticias como «traducción automática sin revisar».
# false = no arranca el planificador y «Refrescar ahora» (POST /api/feed/run) responde 503.
NA_FEED_ENABLED=false
NA_FEED_URL=https://www.tvperu.gob.pe/rss.xml
# Vacío = UA propio del proyecto (app.feed.tvperu.UA_POR_DEFECTO)
NA_FEED_USER_AGENT=
NA_FEED_TIMEOUT=30
# Intervalo inicial en minutos si la base aún no tiene uno: 0 (apagado), 15, 30, 60, 180 o 360
NA_FEED_INTERVALO_MIN=0
# Espera del traductor en el ciclo de fondo (s). El lote de una noticia puede tardar varios minutos en
# una GPU de 6 GB: no use aquí los 120 s de NA_TRANSLATOR_TIMEOUT (pensados para la Redacción).
NA_FEED_TRANSLATOR_TIMEOUT=900
