# Copia este archivo a .env (init.sh lo hace si .env no existe)

# Base de datos SQLite
NA_DATABASE_URL=sqlite:///data/noticias.db

# Hipótesis activa del adaptador ortográfico MMS (ver backend/app/pipeline/tts/adapters/mms_cni.yaml)
NA_MMS_ADAPTER=H1

# Permitir usar entradas con status "candidato-corpus" (no validadas) en la verbalización.
# Cada segmento procesado así queda marcado. Valor por defecto: false.
NA_ALLOW_CANDIDATES=false

# Directorio de modelos descargados por init.sh --with-audio-eval / --with-asr-eval
NA_MODELS_DIR=models

# ---------------------------------------------------------------- Fase 2: síntesis de voz
# Motor TTS: mms_vits (principal, CC-BY-NC) | espeak_ng (línea base, GPL) | fake (pruebas)
NA_TTS_ENGINE=mms_vits
# Hilos de torch para MMS y trabajadores de síntesis concurrentes. Valores elegidos con el barrido
# de la Fase 2 (mayor rendimiento con RTF p95 < 1, ver docs/sizing.md): 4 x 4.
# - Servidor pequeño (2 vCPU / 2 GB): NA_TTS_WORKERS=1.
# - Menor TTFA con un solo usuario: NA_TORCH_THREADS=8, NA_TTS_WORKERS=1.
NA_TORCH_THREADS=4
NA_TTS_WORKERS=4
# Tokenización de la entrada de MMS: manual (T2, adoptada en la tarea 2.2b) | hf (VitsTokenizer)
NA_MMS_TOKENIZATION=manual
# Ruta a espeak-ng si no está en PATH (en Windows se busca también en C:/Program Files/eSpeak NG)
NA_ESPEAK_PATH=
NA_ESPEAK_VOICE=es
# Tasa de Opus (kbps) y límites del modo bajo demanda
NA_OPUS_KBPS=24
NA_MAX_NEWS_CHARS=20000
NA_MAX_CONCURRENT_SYNTH=8
# Carpeta de archivos estáticos (caché de audio y manifiestos)
NA_STATIC_DIR=static
# Cargar el modelo TTS al iniciar el servidor (recomendado en producción)
NA_TTS_PRELOAD=false

# ---------------------------------------------------------------- Fase 3: visemas
# Ancho (ms) de la transicion entre visemas contiguos y fraccion que ocurre antes del limite.
# Vacio = usar los valores de backend/app/pipeline/viseme/resources/map.yaml (50 ms, 0.5).
NA_VISEME_SMOOTH_MS=
NA_VISEME_LEAD=
